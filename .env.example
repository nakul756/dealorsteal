# Auth.js — required. Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google sign-in — optional. The Google button only appears when both are set.
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: lets an LLM write the agent's replies. Without it the rule-based agent is used.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
